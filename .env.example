# Copy to .env (chmod 600) and fill in. .env is not committed.
NEKO_ADMIN_PASSWORD=change-me-admin
NEKO_MEMBER_PASSWORD=change-me-friends

# Your unpacked extension folder (mounted read-only into the shared browser)
GTO_EXTENSION_DIR=/path/to/your/extension

# IP that Neko tells viewers to send video to. Empty = auto-detect public IP (normal use).
NEKO_WEBRTC_NAT1TO1=

# DuckDNS (https://www.duckdns.org) - subdomain without .duckdns.org, and your account token
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
